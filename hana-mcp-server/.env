# Copy this file to .env and fill in all values.
# NEVER commit .env to Git.

# ── HANA connection ──────────────────────────────────────────────────────────
HANA_HOST=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=SYSTEM
HANA_PASSWORD=your_password_here
HANA_SCHEMA=BDC_ASSESSMENT

# Port for the local MCP server (default: 8000)
MCP_PORT=8000

# ── XSUAA JWT auth (local development) ──────────────────────────────────────
# On CF these are injected automatically from VCAP_SERVICES when the
# 'hana-mcp-xsuaa' service is bound. Locally you must set them explicitly.
#
# Step 1 — Create a service key (one-time, after 'hana-mcp-xsuaa' exists on CF):
#   cf create-service-key hana-mcp-xsuaa local-dev-key
#   cf service-key hana-mcp-xsuaa local-dev-key
#
# Step 2 — Copy values from that JSON output into the vars below:
XSUAA_URL= https://adoption-tools-pjpxyi6v.authentication.eu12.hana.ondemand.com
XSUAA_CLIENT_ID=sb-hana-mcp-bdc!t1673807
XSUAA_CLIENT_SECRET=d88bf0a9-9ac0-4354-838c-2e61c90d9bd4$yj58UijG--tScuJLGsDjO_hOo2MLXBfRf6NpTOJn0M4=
XSUAA_APP_NAME=hana-mcp-bdc!t1673807
# XSUAA_VERIFICATION_KEY=  # optional: paste RSA public key to enable offline JWT validation

# ── Getting a test token ─────────────────────────────────────────────────────
# Option A — password grant (SAP BTP user, must have HanaMcpAccess role assigned):
#   curl -s -X POST "$XSUAA_URL/oauth/token" \
#     -H "Content-Type: application/x-www-form-urlencoded" \
#     -u "$XSUAA_CLIENT_ID:$XSUAA_CLIENT_SECRET" \
#     -d "grant_type=password&username=<btp-email>&password=<btp-password>" \
#     | python -m json.tool
#
# Option B — client credentials (service account, for CI/CD or Postman testing):
#   curl -s -X POST "$XSUAA_URL/oauth/token" \
#     -H "Content-Type: application/x-www-form-urlencoded" \
#     -u "$XSUAA_CLIENT_ID:$XSUAA_CLIENT_SECRET" \
#     -d "grant_type=client_credentials" \
#     | python -m json.tool
#
# Use the returned access_token as Bearer:
#   curl -H "Authorization: Bearer <access_token>" http://localhost:8000/mcp
